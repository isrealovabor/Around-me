generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  COMMUNITY_MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum MembershipRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum VerificationSubjectType {
  USER
  BUSINESS
}

enum AuditAction {
  USER_SUSPENDED
  USER_BANNED
  ALERT_VERIFIED
  ALERT_RESOLVED
  BUSINESS_VERIFIED
  MODERATION_DECISION
  SETTINGS_CHANGED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum LocationVerificationStatus {
  VERIFIED
  UNVERIFIED
  NEEDS_REVIEW
}

enum CoordinatesConfidence {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum TrafficConfirmationType {
  STILL_HAPPENING
  CLEARED
  NOT_SEEING_THIS
}

enum PostCategory {
  GENERAL
  QUESTION
  SAFETY
  TRAFFIC
  EMERGENCY
  LOST_FOUND
  MARKETPLACE
  SERVICES
  EVENTS
  JOBS
  LOCAL_ISSUES
}

enum AlertStatus {
  REPORTED
  COMMUNITY_CONFIRMED
  VERIFIED
  RESOLVED
  DISMISSED
}

enum AlertConfidence {
  LOW
  DEVELOPING
  HIGH
}

enum ReportTargetType {
  POST
  COMMENT
  ALERT
  LISTING
  BUSINESS
  USER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
  EXPIRED
}

enum NotificationType {
  COMMENT
  REPLY
  MENTION
  REACTION
  RECOMMENDATION
  COMMUNITY_ANNOUNCEMENT
  SAFETY_ALERT
  MARKETPLACE_ACTIVITY
  EVENT_REMINDER
  MODERATION_ACTION
  VERIFICATION_STATUS
  ACCOUNT_SECURITY
}

enum DeliveryChannel {
  IN_APP
  PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  READ
}

enum DataSourceKind {
  COMMUNITY_REPORT
  NEWS
  GOVERNMENT
  EMERGENCY_SERVICE
  WEATHER
  TRAFFIC
  ELECTRICITY
  PUBLIC_WEB
}

enum DataSourceStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum SourceTrustLevel {
  OFFICIAL_AUTHORITY
  ESTABLISHED_NEWS
  VERIFIED_LOCAL_ORGANISATION
  COMMUNITY_REPORT
  UNKNOWN_PUBLIC
}

enum ExternalEventCategory {
  SECURITY
  ACCIDENT
  FIRE
  FLOOD
  WEATHER
  TRAFFIC
  ROAD_CLOSURE
  POWER
  WATER
  HEALTH
  MISSING_PERSON
  PUBLIC_SAFETY
  INFRASTRUCTURE
  COMMUNITY_ANNOUNCEMENT
  OTHER
}

enum ExternalEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExternalEventProcessingStatus {
  PENDING
  PROCESSED
  NEEDS_REVIEW
  FAILED
  DUPLICATE
}

enum ExternalEventLifecycle {
  ACTIVE
  MONITORING
  RESOLVED
  EXPIRED
}

enum ExternalVerificationStatus {
  UNVERIFIED
  CORROBORATED
  OFFICIALLY_VERIFIED
  REJECTED
}

enum ConfirmationType {
  SEEN
  AFFECTED
  RESOLVED
}

enum AuditActorType {
  USER
  MODERATOR
  SYSTEM
}

enum AlertAuditAction {
  CREATED
  CONFIRMED
  FLAGGED_MISINFORMATION
  STATUS_CHANGED
  NOTIFICATION_HELD
  NOTIFICATION_SENT
  RESOLVED
}

model Location {
  id                    String                     @id @default(cuid())
  name                  String
  slug                  String                     @unique
  type                  String
  countryCode           String                     @default("NG")
  parentId              String?
  parent                Location?                  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children              Location[]                 @relation("LocationHierarchy")
  latitude              Decimal?                   @db.Decimal(9, 6)
  longitude             Decimal?                   @db.Decimal(9, 6)
  source                String? // dataset/provenance label; do not imply official verification
  sourceReference       String?
  verificationStatus    LocationVerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?
  coordinatesConfidence CoordinatesConfidence      @default(NONE)
  boundaryAvailable     Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  communities           Community[]
  users                 User[]                     @relation("UserLocation")

  @@index([parentId, type])
  @@index([countryCode, type, name])
}

model Community {
  id              String                  @id @default(cuid())
  locationId      String
  name            String
  slug            String                  @unique
  description     String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  location        Location                @relation(fields: [locationId], references: [id])
  memberships     CommunityMembership[]
  posts           Post[]
  alerts          CommunityAlert[]
  businesses      Business[]
  listings        MarketplaceListing[]
  announcements   CommunityAnnouncement[]
  primaryProfiles Profile[]               @relation("PrimaryCommunity")
  followers       CommunityFollow[]
  events          LocalEvent[]

  @@index([locationId, isActive])
}

model User {
  id                        String                      @id @default(cuid())
  email                     String                      @unique
  passwordHash              String?
  authProvider              String                      @default("PASSWORD")
  name                      String
  imageUrl                  String?
  phoneNumber               String?                     @unique
  locationId                String?
  role                      UserRole                    @default(USER)
  status                    UserStatus                  @default(ACTIVE)
  emailVerifiedAt           DateTime?
  suspendedAt               DateTime?
  restrictionReason         String?
  restrictionExpiresAt      DateTime?
  verificationStatus        VerificationStatus          @default(UNVERIFIED)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  location                  Location?                   @relation("UserLocation", fields: [locationId], references: [id])
  memberships               CommunityMembership[]
  followedCommunities       CommunityFollow[]
  organizedEvents           LocalEvent[]             @relation("EventOrganizer")
  eventAttendances          EventAttendance[]
  posts                     Post[]
  comments                  Comment[]
  reactions                 Reaction[]
  alertsCreated             CommunityAlert[]            @relation("AlertCreator")
  alertConfirmations        AlertConfirmation[]
  businesses                Business[]
  reviews                   BusinessReview[]
  listings                  MarketplaceListing[]
  reports                   ContentReport[]             @relation("Reporter")
  moderationActions         ContentReport[]             @relation("Moderator")
  notifications             Notification[]
  notificationPrefs         NotificationPreference?
  authTokens                AuthToken[]
  pushSubscriptions         PushSubscription[]
  auditEvents               AlertAuditEvent[]           @relation("AuditActor")
  profile                   Profile?
  verificationRequests      VerificationRequest[]
  assignedModerationCases   ModerationCase[]            @relation("AssignedModerator")
  assignedIntelligenceCases IntelligenceReviewCase[]    @relation("IntelligenceCaseAssignee")
  auditLogs                 AuditLog[]                  @relation("AuditActorLog")
  reportsFiled              UserReport[]                @relation("UserReportReporter")
  trafficConfirmations      TrafficReportConfirmation[]
  savedPosts                SavedPost[]
  businessRecommendations   BusinessRecommendation[]
  businessClaims            BusinessClaim[]
  appeals                   ModerationAppeal[]
  emailDeliveries           EmailDelivery[]

  @@index([locationId, suspendedAt])
  @@index([verificationStatus])
}

model CommunityMembership {
  id          String           @id @default(cuid())
  userId      String
  communityId String
  role        MembershipRole   @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, role, status])
  @@index([userId, status])
}

model CommunityFollow {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, createdAt(sort: Desc)])
}

model Profile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  username           String?            @unique
  photoObjectKey     String?
  phoneNumber        String?
  bio                String?
  primaryCommunityId String?
  locationVisibility String             @default("COMMUNITY_ONLY")
  publicLocationLabel String?
  interests          String[]           @default([])
  onboardingStatus   String             @default("NOT_STARTED")
  onboardingStep     Int                @default(0)
  onboardingCompletedAt DateTime?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryCommunity   Community?         @relation("PrimaryCommunity", fields: [primaryCommunityId], references: [id], onDelete: SetNull)

  @@index([primaryCommunityId])
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     String
  type       String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model EmailDelivery {
  id                String   @id @default(cuid())
  userId            String?
  type              String
  recipient         String
  status            String
  providerMessageId String?
  failureCode       String?
  createdAt         DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@index([recipient, createdAt])
}

model Post {
  id          String          @id @default(cuid())
  authorId    String
  communityId String
  category    PostCategory    @default(GENERAL)
  body        String
  imageUrls   String[]
  isRemoved   Boolean         @default(false)
  visibility  String          @default("COMMUNITY")
  moderationStatus String     @default("ACTIVE")
  urgencyStatus String        @default("NORMAL")
  locationLabel String?
  latitudeApprox Decimal?     @db.Decimal(5, 2)
  longitudeApprox Decimal?    @db.Decimal(5, 2)
  trendingScore Int           @default(0)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  author      User            @relation(fields: [authorId], references: [id])
  community   Community       @relation(fields: [communityId], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  reports     ContentReport[]
  images      PostImage[]
  savedBy     SavedPost[]

  @@index([communityId, createdAt(sort: Desc)])
  @@index([communityId, category, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([moderationStatus, visibility, createdAt(sort: Desc)])
  @@index([trendingScore, createdAt(sort: Desc)])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  objectKey String   @unique
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
}

model Comment {
  id        String          @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  isRemoved Boolean         @default(false)
  moderationStatus String   @default("ACTIVE")
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id])
  parent    Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]       @relation("CommentReplies")
  reports   ContentReport[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String   @default("LIKE")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId, createdAt])
}

model CommunityAlert {
  id                      String              @id @default(cuid())
  communityId             String
  creatorId               String?
  category                String
  title                   String
  description             String
  approximateLocation     String
  occurredAt              DateTime?
  status                  AlertStatus         @default(REPORTED)
  confidence              AlertConfidence     @default(LOW)
  requiresHumanReview     Boolean             @default(false)
  broadNotificationSentAt DateTime?
  duplicateOfAlertId      String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  community               Community           @relation(fields: [communityId], references: [id])
  creator                 User?               @relation("AlertCreator", fields: [creatorId], references: [id])
  duplicateOf             CommunityAlert?     @relation("AlertDuplicates", fields: [duplicateOfAlertId], references: [id])
  duplicates              CommunityAlert[]    @relation("AlertDuplicates")
  confirmations           AlertConfirmation[]
  sources                 AlertSource[]
  reports                 ContentReport[]
  auditEvents             AlertAuditEvent[]
  updates                 AlertUpdate[]

  @@index([communityId, status, createdAt(sort: Desc)])
  @@index([communityId, category, createdAt(sort: Desc)])
  @@index([requiresHumanReview, status])
}

model AlertUpdate {
  id        String         @id @default(cuid())
  alertId   String
  authorId  String?
  status    AlertStatus?
  body      String
  createdAt DateTime       @default(now())
  alert     CommunityAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt(sort: Desc)])
}

model AlertConfirmation {
  id        String           @id @default(cuid())
  alertId   String
  userId    String
  type      ConfirmationType @default(SEEN)
  note      String?
  createdAt DateTime         @default(now())
  alert     CommunityAlert   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId, type])
  @@index([alertId, createdAt])
}

model DataSource {
  id                     String           @id @default(cuid())
  name                   String
  kind                   DataSourceKind
  status                 DataSourceStatus @default(PAUSED)
  trustLevel             SourceTrustLevel @default(UNKNOWN_PUBLIC)
  baseUrl                String?
  pollingIntervalMinutes Int?
  enabledRegions         String[]
  lastSuccessfulSyncAt   DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  externalEvents         ExternalEvent[]

  @@index([kind, status])
}

model ExternalEvent {
  id                 String                        @id @default(cuid())
  dataSourceId       String
  externalId         String?
  sourceType         DataSourceKind
  receivedAt         DateTime                      @default(now())
  occurredAt         DateTime?
  originalTitle      String
  originalContent    String
  originalUrl        String
  contentHash        String
  rawPayload         Json
  locationHint       String?
  detectedCategory   ExternalEventCategory?
  detectedLocation   String?
  latitude           Decimal?                      @db.Decimal(9, 6)
  longitude          Decimal?                      @db.Decimal(9, 6)
  state              String?
  city               String?
  neighbourhood      String?
  severity           ExternalEventSeverity?
  confidence         AlertConfidence               @default(LOW)
  verificationStatus ExternalVerificationStatus    @default(UNVERIFIED)
  duplicateGroupId   String?
  eventClusterId     String?
  processingStatus   ExternalEventProcessingStatus @default(PENDING)
  lifecycle          ExternalEventLifecycle        @default(MONITORING)
  processingError    String?
  dataSource         DataSource                    @relation(fields: [dataSourceId], references: [id])
  alertSources       AlertSource[]
  reviewCases        IntelligenceReviewCase[]
  eventCluster       EventCluster?                 @relation(fields: [eventClusterId], references: [id], onDelete: SetNull)

  @@unique([dataSourceId, externalId])
  @@unique([dataSourceId, contentHash])
  @@index([dataSourceId, receivedAt(sort: Desc)])
  @@index([occurredAt])
  @@index([processingStatus, receivedAt(sort: Desc)])
  @@index([duplicateGroupId])
  @@index([state, city, detectedCategory])
  @@index([eventClusterId, processingStatus])
}

model EventCluster {
  id                String                 @id @default(cuid())
  canonicalTitle    String
  canonicalCategory ExternalEventCategory?
  status            ExternalEventLifecycle @default(MONITORING)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  externalEvents    ExternalEvent[]

  @@index([canonicalCategory, status, updatedAt(sort: Desc)])
}

model IntelligenceReviewCase {
  id              String        @id @default(cuid())
  externalEventId String
  reason          String
  priority        String        @default("NORMAL")
  status          ReportStatus  @default(OPEN)
  assignedToId    String?
  decision        String?
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?
  externalEvent   ExternalEvent @relation(fields: [externalEventId], references: [id], onDelete: Cascade)
  assignedTo      User?         @relation("IntelligenceCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt(sort: Desc)])
}

model AlertSource {
  id              String         @id @default(cuid())
  alertId         String
  externalEventId String?
  sourceKind      DataSourceKind
  sourceUrl       String?
  observedAt      DateTime       @default(now())
  alert           CommunityAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  externalEvent   ExternalEvent? @relation(fields: [externalEventId], references: [id])

  @@index([alertId, observedAt])
  @@index([externalEventId])
}

model AlertAuditEvent {
  id        String           @id @default(cuid())
  alertId   String
  actorId   String?
  actorType AuditActorType
  action    AlertAuditAction
  reason    String?
  metadata  Json?
  createdAt DateTime         @default(now())
  alert     CommunityAlert   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actor     User?            @relation("AuditActor", fields: [actorId], references: [id])

  @@index([alertId, createdAt])
  @@index([action, createdAt])
}

model Business {
  id                 String                   @id @default(cuid())
  ownerId            String?
  communityId        String
  name               String
  slug               String                   @unique
  description        String
  categoryId         String?
  serviceArea        String
  phoneNumber        String?
  email              String?
  website            String?
  publicAddress      String?
  latitudeApprox     Decimal?                 @db.Decimal(5, 2)
  longitudeApprox    Decimal?                 @db.Decimal(5, 2)
  openingHours       Json?
  claimStatus        String                   @default("UNCLAIMED")
  imageUrls          String[]
  verificationStatus VerificationStatus       @default(UNVERIFIED)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  owner              User?                    @relation(fields: [ownerId], references: [id])
  community          Community                @relation(fields: [communityId], references: [id])
  reviews            BusinessReview[]
  reports            ContentReport[]
  categoryRecord     BusinessCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             BusinessImage[]
  recommendations    BusinessRecommendation[]
  claims             BusinessClaim[]

  @@index([communityId, categoryId, isActive])
  @@index([verificationStatus])
  @@index([name])
}

model BusinessClaim {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  status     String    @default("REQUESTED")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([status, createdAt(sort: Desc)])
}

model BusinessCategory {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  businesses Business[]

  @@index([name])
}

model LocalEvent {
  id              String    @id @default(cuid())
  communityId     String
  organizerId     String
  title           String
  description     String
  category        String
  venueName       String?
  locationLabel   String?
  latitudeApprox  Decimal?  @db.Decimal(5, 2)
  longitudeApprox Decimal?  @db.Decimal(5, 2)
  startAt         DateTime
  endAt           DateTime?
  imageObjectKey  String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizer       User      @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendees       EventAttendance[]

  @@index([communityId, startAt])
  @@index([status, startAt])
}

model EventAttendance {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    String     @default("INTERESTED")
  createdAt DateTime   @default(now())
  event     LocalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  objectKey  String   @unique
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, position])
}

model BusinessRecommendation {
  id         String   @id @default(cuid())
  businessId String
  authorId   String
  postId     String?
  note       String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([businessId, authorId])
  @@index([businessId, createdAt(sort: Desc)])
}

model BusinessReview {
  id         String   @id @default(cuid())
  businessId String
  authorId   String
  body       String
  rating     Int?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])

  @@unique([businessId, authorId])
  @@index([businessId, createdAt(sort: Desc)])
}

model MarketplaceListing {
  id                  String               @id @default(cuid())
  sellerId            String
  communityId         String
  title               String
  description         String
  price               Decimal              @db.Decimal(12, 2)
  currency            String               @default("NGN")
  categoryId          String?
  imageUrls           String[]
  approximateLocation String
  status              ListingStatus        @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  seller              User                 @relation(fields: [sellerId], references: [id])
  community           Community            @relation(fields: [communityId], references: [id])
  reports             ContentReport[]
  categoryRecord      MarketplaceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images              MarketplaceImage[]

  @@index([communityId, status, createdAt(sort: Desc)])
  @@index([communityId, categoryId, status, createdAt(sort: Desc)])
  @@index([sellerId, status])
}

model MarketplaceCategory {
  id       String               @id @default(cuid())
  name     String
  slug     String               @unique
  listings MarketplaceListing[]
}

model MarketplaceImage {
  id        String             @id @default(cuid())
  listingId String
  objectKey String             @unique
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

model ContentReport {
  id           String              @id @default(cuid())
  reporterId   String
  moderatorId  String?
  targetType   ReportTargetType
  postId       String?
  commentId    String?
  alertId      String?
  businessId   String?
  listingId    String?
  targetUserId String?
  reason       String
  details      String?
  status       ReportStatus        @default(OPEN)
  resolution   String?
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  reporter     User                @relation("Reporter", fields: [reporterId], references: [id])
  moderator    User?               @relation("Moderator", fields: [moderatorId], references: [id])
  post         Post?               @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  alert        CommunityAlert?     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  business     Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing      MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, createdAt(sort: Desc)])
}

model Notification {
  id         String                 @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String
  entityId   String
  data       Json?
  idempotencyKey String? @unique
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([userId, idempotencyKey])
}

model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  deliveredAt    DateTime?
  error          String?
  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([channel, status])
  @@unique([notificationId, channel])
}

model NotificationPreference {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  commentsEnabled        Boolean @default(true)
  recommendationsEnabled Boolean @default(true)
  announcementsEnabled   Boolean @default(true)
  safetyAlertsEnabled    Boolean @default(true)
  marketplaceEnabled     Boolean @default(true)
  pushEnabled            Boolean @default(false)
  emailEnabled           Boolean @default(true)
  repliesCommentsEnabled Boolean @default(true)
  mentionsEnabled        Boolean @default(true)
  localAlertsEnabled     Boolean @default(true)
  eventRemindersEnabled  Boolean @default(true)
  communityUpdatesEnabled Boolean @default(true)
  marketingEnabled       Boolean @default(false)
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CommunityAnnouncement {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  title       String
  body        String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id])

  @@index([communityId, publishedAt(sort: Desc)])
}

model VerificationRequest {
  id          String                  @id @default(cuid())
  userId      String
  subjectType VerificationSubjectType
  subjectId   String
  status      VerificationStatus      @default(PENDING)
  evidenceKey String?
  reviewedAt  DateTime?
  createdAt   DateTime                @default(now())
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model UserReport {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?
  createdAt  DateTime         @default(now())
  reporter   User             @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  case       ModerationCase?

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([reporterId, createdAt(sort: Desc)])
}

model ModerationCase {
  id           String               @id @default(cuid())
  reportId     String?              @unique
  status       ModerationCaseStatus @default(OPEN)
  priority     ModerationPriority   @default(NORMAL)
  assignedToId String?
  outcome      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resolvedAt   DateTime?
  report       UserReport?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  assignedTo   User?                @relation("AssignedModerator", fields: [assignedToId], references: [id], onDelete: SetNull)
  actions      ModerationAction[]

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([assignedToId, status])
}

model ModerationAppeal {
  id          String    @id @default(cuid())
  userId      String
  caseId      String
  reason      String
  status      String    @default("SUBMITTED")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
  @@index([status, createdAt(sort: Desc)])
}

model ModerationAction {
  id        String         @id @default(cuid())
  caseId    String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime       @default(now())
  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActorLog", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model EmergencyPlace {
  id          String    @id @default(cuid())
  locationId  String?
  name        String
  type        String
  phoneNumber String?
  address     String?
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  sourceUrl   String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([type, verifiedAt])
}

model InfrastructureReport {
  id          String   @id @default(cuid())
  communityId String
  reporterId  String?
  category    String
  description String
  status      String   @default("REPORTED")
  createdAt   DateTime @default(now())

  @@index([communityId, status, createdAt(sort: Desc)])
}

model TrafficReport {
  id            String                      @id @default(cuid())
  communityId   String?
  locationId    String?
  sourceId      String?
  category      String
  status        String                      @default("ACTIVE")
  occurredAt    DateTime                    @default(now())
  expiresAt     DateTime?
  confirmations TrafficReportConfirmation[]

  @@index([communityId, status, occurredAt(sort: Desc)])
}

model TrafficReportConfirmation {
  id              String                  @id @default(cuid())
  trafficReportId String
  userId          String
  type            TrafficConfirmationType
  createdAt       DateTime                @default(now())
  trafficReport   TrafficReport           @relation(fields: [trafficReportId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trafficReportId, userId])
  @@index([trafficReportId, type, createdAt])
}

model PowerReport {
  id                  String    @id @default(cuid())
  communityId         String
  locationId          String?
  sourceId            String?
  kind                String
  distributionCompany String?
  feeder              String?
  transformerLabel    String?
  confirmations       Int       @default(0)
  status              String    @default("REPORTED")
  occurredAt          DateTime  @default(now())
  restoredAt          DateTime?

  @@index([communityId, status, occurredAt(sort: Desc)])
}

model WeatherEvent {
  id         String    @id @default(cuid())
  locationId String?
  sourceId   String?
  category   String
  severity   String?
  observedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@index([locationId, observedAt(sort: Desc)])
}

model FloodReport {
  id          String    @id @default(cuid())
  communityId String?
  sourceId    String?
  status      String    @default("REPORTED")
  occurredAt  DateTime  @default(now())
  expiresAt   DateTime?

  @@index([communityId, status, occurredAt(sort: Desc)])
}
