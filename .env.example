# Browser-visible configuration only. Never prefix secrets with VITE_.
VITE_API_URL=http://localhost:3000
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token-restricted-by-origin

# Required server configuration. Copy to .env and replace every placeholder.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
AUTH_SESSION_SECRET="generate-a-random-secret-at-least-32-characters-long"
APP_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
PORT=3000
BETA_MODE=false
ENABLE_AI=true
ENABLE_EMAIL_DELIVERY=true
ENABLE_VERIFICATION=true
ENABLE_BUSINESS_CLAIMS=true

# Infrastructure required before respective live capabilities are enabled.
REDIS_URL=
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-server-only-upstash-token
RESEND_API_KEY=
EMAIL_FROM="Around Me <onboarding@resend.dev>"
EMAIL_REPLY_TO=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
OPENAI_API_KEY=your-server-only-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
MAPBOX_BACKEND_TOKEN=your-server-only-mapbox-token
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_POST_IMAGES=post-images
STORAGE_BUCKET_MARKETPLACE=marketplace-images
STORAGE_BUCKET_BUSINESSES=business-images
STORAGE_BUCKET_VERIFICATION=verification-documents
AI_PROVIDER_API_KEY=
GEOCODING_PROVIDER_API_KEY=
MAP_PROVIDER_API_KEY=
PUSH_PROVIDER_PRIVATE_KEY=
